# Required for live runs. Without both keys the app runs in mock mode.
ANTHROPIC_API_KEY=
FAL_KEY=

# Your private passcode. Open the site once with ?owner=YOUR_PASSCODE to get unlimited runs
# and the "Save run as example" button on that browser.
OWNER_PASSCODE=

# Any long random string. Signs the short-lived run tokens.
RUN_SECRET=

# Public demo limits (visitors only; the owner is never limited)
LIVE_RUNS_PER_DAY=20
LIVE_RUNS_PER_IP=2

# Optional: Upstash Redis (add it from the Vercel Marketplace) so limits hold across servers.
# Vercel fills these in for you when you connect the integration.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional model overrides
CLAUDE_MODEL=claude-sonnet-5-5
FAL_IMAGE_MODEL=fal-ai/flux-2-pro
FAL_EDIT_MODEL=fal-ai/nano-banana-2/edit

# Set to 1 to force mock mode even with keys present
MOCK=
